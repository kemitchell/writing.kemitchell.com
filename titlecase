#!/usr/bin/env ruby
require 'yaml'

words = {}
Dir.glob('_posts/*.md').each do |file|
  contents = File.read(file)
  yaml = /\A---\s*\n(.*?)\n---/m.match(contents)[1]
  parsed = YAML.safe_load(yaml, permitted_classes: [Time, Date])
  title = parsed['title']
  next if title.nil?
  title.split(/\s+/).each do |word|
    if words.key?(word)
      words[word] << title
    else
      words[word] = [title]
    end
  end
end

ignored_words = %w{git with an the a for this in by from and that}

words.each_key do |word|
  in_lower_case = word.downcase
  next if ignored_words.include?(in_lower_case)
  next if in_lower_case == word
  if words.key?(in_lower_case)
    puts "#{word} and #{in_lower_case}"
    words[word].each { |title| puts "  #{title}" }
    words[in_lower_case].each { |title| puts "  #{title}" }
  end
end
